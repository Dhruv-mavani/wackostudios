# Web3Forms access key for the "Schedule a meeting" form. Get one free at https://web3forms.com (enter the inbox
# that should receive requests). It is safe to expose: it only routes form submissions to that inbox.
# Copy this file to .env.local, and add the same variable in Vercel (Project > Settings > Environment Variables).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Branded booking emails (app/api/book + lib/bookingEmail.ts), sent through Resend (https://resend.com).
# SERVER-SIDE SECRETS: set these in Vercel and .env.local only. Never prefix them with NEXT_PUBLIC_.
# Without RESEND_API_KEY the form falls back to Web3Forms above.
RESEND_API_KEY=
# Where requests are delivered (defaults to the agency email). With Resend's shared test sender this must be the
# same address you signed up to Resend with.
BOOKING_TO_EMAIL=
# Sender. Defaults to "Wacko Studios <onboarding@resend.dev>". Use your own verified domain when you have one.
BOOKING_FROM_EMAIL=
# Optional: sender on a VERIFIED domain. If set, every visitor also gets a branded confirmation at the email they entered.
BOOKING_CONFIRM_FROM=

# Website chat assistant (app/api/chat, lib/chatProviders.ts, components/Chatbot.tsx). SERVER-SIDE SECRETS: never prefix with NEXT_PUBLIC_.
# Models are tried in order until one answers: Gemini main model, then a second Gemini model, then Claude (optional, paid).
# Main: free key from https://aistudio.google.com/apikey. Without any key the chat shows a WhatsApp / email fallback.
GEMINI_API_KEY=
# Optional model overrides (defaults, tried in order: gemini-3.1-flash-lite, gemini-3.5-flash-lite, gemini-3.6-flash; each has its own free quota).
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_THIRD_MODEL=
# Optional paid last resort, only used if both Gemini models fail. Key from https://console.anthropic.com (billed separately
# from a Claude subscription). Leave empty to stay fully free.
ANTHROPIC_API_KEY=
CHAT_MODEL=
# Chat leads are emailed to BOOKING_TO_EMAIL through the Resend settings above.
